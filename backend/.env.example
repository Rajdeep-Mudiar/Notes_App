# =================================================================
# STUDENT OS - BACKEND ENVIRONMENT EXAMPLE TEMPLATE
# Copy this file to .env and configure your variables
# =================================================================

# --- Application Info ---
PROJECT_NAME="Student OS API"
VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=True

# --- MongoDB Database ---
# Local MongoDB: mongodb://localhost:27017
# Or MongoDB Atlas Cloud: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URL="mongodb://localhost:27017"
DATABASE_NAME="student_os"

# --- Security & Authentication ---
# Generate a random 64+ char secret for production
JWT_SECRET="replace_with_a_secure_random_key_for_production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Network & Server Settings ---
HOST="0.0.0.0"
PORT=8000
CORS_ORIGINS=["*"]

# --- AI & Study Assistant (Hugging Face Free Serverless API) ---
# Create a free access token (Role: Read) at: https://huggingface.co/settings/tokens
# Paste your token below (starts with hf_...):
HUGGINGFACE_API_KEY=""

# Recommended Free Serverless Chat/LLM Models:
# - "meta-llama/Llama-3.2-3B-Instruct" (Default, fast and high quality)
# - "mistralai/Mistral-7B-Instruct-v0.3"
# - "Qwen/Qwen2.5-7B-Instruct"
HUGGINGFACE_CHAT_MODEL="meta-llama/Llama-3.2-3B-Instruct"

# Recommended Free Serverless Embedding Models:
# - "sentence-transformers/all-mpnet-base-v2" (768-dim, Default)
# - "sentence-transformers/all-MiniLM-L6-v2" (384-dim)
# - "BAAI/bge-small-en-v1.5"
HUGGINGFACE_EMBEDDING_MODEL="sentence-transformers/all-mpnet-base-v2"

# --- Optional Alternative: Google Gemini API ---
# Get free key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""
